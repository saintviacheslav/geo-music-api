# Connection strings of the nine nodes. Both JDBC URLs and libpq URIs are accepted:
#   jdbc:postgresql://host:5432/geomusic
#   postgresql://user:password@host:5432/geomusic?sslmode=require
AMER_MASTER_URL=jdbc:postgresql://localhost:6411/geomusic
AMER_REPLICA1_URL=jdbc:postgresql://localhost:6412/geomusic
AMER_REPLICA2_URL=jdbc:postgresql://localhost:6413/geomusic
EURO_MASTER_URL=jdbc:postgresql://localhost:6421/geomusic
EURO_REPLICA1_URL=jdbc:postgresql://localhost:6422/geomusic
EURO_REPLICA2_URL=jdbc:postgresql://localhost:6423/geomusic
ASIA_MASTER_URL=jdbc:postgresql://localhost:6431/geomusic
ASIA_REPLICA1_URL=jdbc:postgresql://localhost:6432/geomusic
ASIA_REPLICA2_URL=jdbc:postgresql://localhost:6433/geomusic

# Credentials used for every node unless the connection string carries its own
DB_USERNAME=geo
DB_PASSWORD=geo
DB_NAME=geomusic
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator

# Region used when a request has no X-User-Region header
DEFAULT_USER_REGION=EURO

# Pools and fail-over
DB_POOL_MASTER_MAX_SIZE=20
DB_POOL_REPLICA_MAX_SIZE=30
DB_CONNECTION_TIMEOUT=2s
DB_HEALTH_PROBE_INTERVAL=5s

# Migrations (Flyway on every regional master)
DB_MIGRATION_ENABLED=true
DB_MIGRATION_FAIL_ON_ERROR=false

# Observability
DEPLOYMENT_NAME=geo
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0
